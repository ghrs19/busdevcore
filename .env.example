# --- Database -------------------------------------------------------------
# Option A: a single connection string for ANY PostgreSQL (Neon, self-hosted,
# or another hosted provider). Recommended; use the pooled endpoint on Neon.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option B: discrete variables, used only when DATABASE_URL is not set.
# Defaults target a local PostgreSQL (localhost:5432, db/user/pass below).
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=busdevcore
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=true            # only for servers requiring TLS without a local CA

# --- Auth -------------------------------------------------------------------
AUTH_SECRET=change-me-to-a-long-random-string

# --- Object storage -----------------------------------------------------------
# Driver: "postgres" (default) stores files as BYTEA in the file_objects table
# of the same database; "minio" stores them in a dedicated MinIO server.
STORAGE_DRIVER=postgres

# Required only when STORAGE_DRIVER=minio:
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=busdevcore

# --- AI gateway (Hermes, optional) -------------------------------------------
# HERMES_API_URL=
# HERMES_API_KEY=
