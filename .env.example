# --- Database -------------------------------------------------------------
# Option A: a single connection string for ANY PostgreSQL (Neon, self-hosted,
# or another hosted provider). Recommended; use the pooled endpoint on Neon.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option B: discrete variables, used only when DATABASE_URL is not set.
# Defaults target a local PostgreSQL (localhost:5432, db/user/pass below).
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=busdevcore
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=true            # only for servers requiring TLS without a local CA

# --- Auth -------------------------------------------------------------------
AUTH_SECRET=change-me-to-a-long-random-string

# --- Object storage -----------------------------------------------------------
# Driver: "postgres" (default) stores files as BYTEA in the file_objects table
# of the same database; "minio" stores them in a dedicated MinIO server.
STORAGE_DRIVER=postgres

# Required only when STORAGE_DRIVER=minio:
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=busdevcore

# Google Drive driver: set STORAGE_DRIVER=gdrive and provide the target
# folder plus ONE of the two auth modes below.
# GOOGLE_DRIVE_FOLDER_ID=
# Mode 1 - OAuth refresh token (files owned by that Google account; best for
# personal accounts):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# Mode 2 - service account (base64-encoded key JSON in one variable, or the
# EMAIL/PRIVATE_KEY pair). Service accounts have no storage quota of their
# own, so uploads need a Shared Drive or impersonation of a Workspace user:
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_DRIVE_IMPERSONATE_EMAIL=

# --- AI gateway (Hermes, optional) -------------------------------------------
# HERMES_API_URL=
# HERMES_API_KEY=
